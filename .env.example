# Values to add to Coolify > Environment Variables. Do not commit a real .env.
# Secrets: generate 32+ random alphanumeric chars each (no #, ?, /, @, :, $).
REDIS_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_32_CHARS
BAILEYS_API_KEY=REPLACE_WITH_RANDOM_ALPHANUMERIC_48_CHARS
DASHBOARD_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_12_CHARS_MIN
WEBHOOK_SECRET=REPLACE_WITH_RANDOM_ALPHANUMERIC_32_CHARS
# Exactly the dashboard URL assigned in Coolify, no trailing slash, no :3080
PUBLIC_URL=http://REPLACE_WITH_DASHBOARD_DOMAIN.sslip.io
